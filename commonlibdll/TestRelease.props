<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CommonLibDir>$(SolutionDir)..\commonlibdll\common</CommonLibDir>
    <CurrentModuleDir>$(SolutionDir)..\commonlibdll\$(SolutionName)</CurrentModuleDir>
    <LocalDebuggerEnvironment>PATH=$(QtBinDir);$(CommonLibDir)\bin;$(CurrentModuleDir)\bin;%PATH%</LocalDebuggerEnvironment>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(CommonLibDir)\include;
        $(CurrentModuleDir)\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(CommonLibDir)\lib;
        $(CurrentModuleDir)\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        common.lib;
        $(SolutionName).lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
