# =========================
# 编译输出目录 (VS CMake默认)
# =========================
out/
build/
bin/
obj/

# =========================
# 数据库本地文件 (防止覆盖队友数据)
# =========================
*.db
*.db-journal
*.sqlite
*.sqlite3

# =========================
# Visual Studio 缓存与本地配置
# =========================
.vs/
*.user
CMakeSettings.json
CMakeUserPresets.json

# =========================
# Qt 自动生成的文件 (如果你使用 in-source 构建)
# =========================
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc
*.rcc

# =========================
# 其他操作系统/编辑器缓存
# =========================
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln.docstates